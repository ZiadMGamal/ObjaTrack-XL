OBJATRACK_ENV=development
OBJATRACK_LOG_LEVEL=INFO
OBJATRACK_LOG_FORMAT=json
OBJATRACK_MODEL_DIR=./models
OBJATRACK_OUTPUT_DIR=./outputs
OBJATRACK_DATA_DIR=./data
OBJATRACK_DEVICE=auto
OBJATRACK_CUDA_VISIBLE_DEVICES=0
OBJATRACK_API_HOST=0.0.0.0
OBJATRACK_API_PORT=8000
OBJATRACK_API_WORKERS=1
OBJATRACK_ENABLE_CORS=true
OBJATRACK_RTSP_URL=rtsp://localhost:8554/stream
OBJATRACK_WEBCAM_INDEX=0
OBJATRACK_MODEL_NAME=yolov8n.pt
OBJATRACK_CONFIDENCE_THRESHOLD=0.25
OBJATRACK_IOU_THRESHOLD=0.45
OBJATRACK_TRACKER_TYPE=botsort
OBJATRACK_MAX_AGE=30
OBJATRACK_MIN_HITS=3
OBJATRACK_ENABLE_GPU_MONITORING=false
